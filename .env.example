# ============================================================
# Cleaning House — Environment Variables Template
# انسخ هذا الملف إلى .env وعدّل القيم محليًا. لا تضع .env في Git.
# ============================================================

# --- Django Core ---
# 🔴 DJANGO_ENV إلزامي بلا default — غيابه يُسقط الإقلاع برسالة واضحة.
#    القيم المسموحة: dev | staging | production
DJANGO_ENV=dev
SECRET_KEY=change-me-in-local-env
DEBUG=True
#
# 🔴 ALLOWED_HOSTS إلزامي فعليًا بالإنتاج — رغم أن له default="" في
#    settings فلا يُسقط الإقلاع. الفراغ مقصود أمنيًا (أفضل من "*"
#    كافتراضي)، لكن أثره عند DEBUG=False أن **كل طلب يُرفض بـ400
#    DisallowedHost**. فالإقلاع ينجح والتطبيق لا يخدم شيئًا.
#
#    اضبطه يدويًا بلوحة Railway (ليس سرًا، لكنه ليس جزءًا من الكود
#    المرفوع لأنه يختلف بكل بيئة). مثال:
#        ALLOWED_HOSTS=yourapp.up.railway.app
#    ولعدة نطاقات: قائمة مفصولة بفواصل بلا مسافات.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# محليًا (DJANGO_ENV=dev): يُستخدم SQLite تلقائيًا (db.sqlite3) —
# لا حاجة لأي من متغيرات DB_* أدناه في هذه الحالة.
#
# 🔴 في Staging/Production طريقتان — واحدة منهما إلزامية:
#
#    (1) DATABASE_URL وحدها — المفضَّلة على منصات النشر (Railway/Heroku)
#        فهي تُحقن تلقائيًا عند ربط قاعدة بيانات:
#            DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/NAME
#        المخطط: postgres أو postgresql أو pgsql. المنفذ اختياري (5432).
#        الرموز المرمَّزة (%40 مثلًا) تُفكّ، فكلمة مرور فيها @ تعمل.
#
#    (2) أو متغيرات DB_* المنفصلة أدناه — DB_NAME و DB_USER و DB_PASSWORD
#        إلزامية بلا default، وغيابها يُسقط التطبيق عند الإقلاع تمامًا
#        كما يفعل SECRET_KEY. DB_HOST و DB_PORT لهما defaults.
#
#    الأولوية لـDATABASE_URL إن وُجدت وغير فارغة؛ وإلا تُستخدم DB_*.
#
# ⚠️ على Railway: مراجع ${{Service.VAR}} قد تُحَل إلى نص فارغ بصمت.
#    إن بدا متغيّر فارغًا، انسخ القيمة الحرفية من تبويب Variables الخاص
#    بخدمة قاعدة البيانات نفسها بدل تصحيح صيغة المرجع.
# DATABASE_URL=postgres://postgres:password@localhost:5432/cleaning_house_dev
DB_NAME=cleaning_house_dev
DB_USER=postgres
DB_PASSWORD=change-me-not-a-real-password
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
JWT_SIGNING_KEY=change-me-in-local-env
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============================================================
# ملاحظة: لا توجد هنا أي متغيرات لـProviders خارجيين
# (Payment Gateway, SMS Gateway, File Storage, ...)
# لأن جميعها 🔴/🟡/🟢 Open Decisions لم تُحسم بعد.
# ستُضاف عند تفعيل Adapter فعلي لكل تكامل.
# ============================================================

# --- SMS Adapter (Identity Domain) ---
# SMS Gateway Provider قرار مفتوح. الافتراضي adapter تطويري يطبع الرمز
# في الـconsole فقط. عند حسم الـProvider يُغيَّر هذا المسار فقط.
SMS_ADAPTER=adapters.sms.dev_console.DevConsoleSMSAdapter
# يسمح باستخدام DevConsoleSMSAdapter رغم DEBUG=False (بيئات الاختبار فقط)
SMS_DEV_ALLOW_INSECURE=False

# --- OTP Policy ---
# ⚠️ defaults آمنة بانتظار تأكيد Product Owner — ليست قواعد عمل نهائية.
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_CODE_LENGTH=6
# حدود الطلب — 0 = بلا حد
OTP_MAX_REQUESTS_PER_PHONE_PER_DAY=10
OTP_MAX_REQUESTS_PER_IP_PER_HOUR=20
#
# 🧪 أرقام اختبار: لا تُرسل لها SMS وتقبل رمزها الثابت فقط. لتجربة الدخول
#    على السيرفر قبل التعاقد مع مزوّد SMS. كل رقم آخر يبقى محميًا.
#    الشكل: رقم:رمز مفصولة بفواصل، والرمز بطول OTP_CODE_LENGTH.
#    ⚠️ استخدم أرقامًا لا يملكها أحد، ولا تمنح حساباتها صلاحية ADMIN.
#    احذف المتغير عند الإطلاق الفعلي.
# OTP_TEST_NUMBERS=+61400000001:246810,+61400000002:135790
# وضع التجريب قبل مزوّد SMS: أرقام الاختبار تعمل أيضًا كعامل ثانٍ للأدمن
# (كلمة السر تبقى مطلوبة)، وتتوقف كلها تلقائيًا بعد التاريخ المحدد.
# OTP_TEST_NUMBERS_ALLOW_ADMIN=True
# OTP_TEST_MODE_UNTIL=2026-10-31
#
# عدد البروكسيات أمام التطبيق (لاستخراج IP العميل لحد طلبات OTP).
# الافتراضي 0 محليًا و1 في staging/production (بروكسي Railway).
# NUM_TRUSTED_PROXIES=1

# --- Admin login (بريد/هاتف + كلمة سر + رمز SMS على هاتف الأدمن) ---
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15
# الجهاز الذي اجتاز رمز SMS يُعفى منه هذه المدة
ADMIN_TRUSTED_DEVICE_DAYS=30

# --- Push notifications (Firebase Cloud Messaging) ---
# الاستضافة: محتوى ملف حساب الخدمة كاملًا في سطر واحد (سرّ — لا يُرفع إلى Git)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# محليًا: مسار الملف بدلًا منه
# FIREBASE_CREDENTIALS_FILE=cleano-677af-firebase-adminsdk-xxxx.json
# الافتراضي FCMPushAdapter؛ dev يستعمل FakePushAdapter ما لم يُضبط هذا
# PUSH_ADAPTER=adapters.push_notification.fcm.FCMPushAdapter
# inline (بلا عامل خلفي) أو celery
NOTIFICATIONS_DELIVERY=inline
NOTIFICATIONS_RETENTION_DAYS=90
# قنوات Android — تُضبط حسب ما يحدده تطبيق الموبايل
NOTIFICATION_CHANNEL_HIGH=offers
NOTIFICATION_CHANNEL_NORMAL=general

# --- Dispatch & Scheduling (قرارات PO — 2026-09-24) ---
# أقصى مسافة بين المقاول والعقار لإرسال عرض (كم). 0 = بلا حد.
DISPATCH_MAX_DISTANCE_KM=50
# أقل مهلة بين الآن وموعد الزيارة عند الحجز/إعادة الجدولة (دقائق).
BOOKING_MIN_LEAD_MINUTES=120

# --- Job photos ---
JOB_PHOTO_MAX_BYTES=10485760
JOB_PHOTO_MAX_PER_JOB=30

# --- Social Auth (Sign in with Apple / Google) ---
# الافتراضي adapter وهمي للاختبار/التطوير. التحقق الحقيقي يتطلب اعتمادات
# تشغيلية (Apple Developer keys / Google OAuth client IDs) تُضاف كمتغيرات
# بيئة عند تجهيزها — لا تُوضع في الكود.
SOCIAL_AUTH_ADAPTER=adapters.social_auth.fake.FakeSocialAuthAdapter
# يسمح باستخدام الـadapter الوهمي رغم DEBUG=False (بيئات الاختبار فقط)
SOCIAL_AUTH_ALLOW_FAKE=False

# --- Payment Provider (Payment Domain) ---
# مزوّد الدفع قرار مفتوح. الافتراضي adapter وهمي لا يشحن أي مبلغ حقيقي.
PAYMENT_PROVIDER_ADAPTER_CLASS=apps.payments.adapters.fake_adapter.FakePaymentAdapter
# يسمح بالـadapter الوهمي رغم DEBUG=False (بيئات الاختبار فقط)
PAYMENTS_ALLOW_FAKE_ADAPTER=False

# --- Payout Provider (Payout Domain) ---
# مزوّد الدفع للمقاولين قرار مفتوح. الافتراضي adapter وهمي لا يحوّل مبلغًا.
PAYOUT_PROVIDER_ADAPTER_CLASS=apps.payouts.adapters.fake_adapter.FakePayoutAdapter
# يسمح بالـadapter الوهمي رغم DEBUG=False (بيئات الاختبار فقط)
PAYOUTS_ALLOW_FAKE_ADAPTER=False

# --- File Storage (Jobs Domain) ---
# مزوّد التخزين قرار مفتوح. الافتراضي adapter وهمي يُهمل محتوى الملفات.
JOB_STORAGE_ADAPTER_CLASS=apps.jobs.adapters.fake_adapter.FakeStorageAdapter
# يسمح بالـadapter الوهمي رغم DEBUG=False (بيئات الاختبار فقط)
JOBS_ALLOW_FAKE_STORAGE_ADAPTER=False

# ============================================================
# ⚠️ المتغيرات الإلزامية (بلا default في settings) — غيابها يُسقط الإقلاع:
#     DJANGO_ENV                             (كل البيئات)
#     SECRET_KEY, JWT_SIGNING_KEY            (كل البيئات)
#     DB_NAME, DB_USER, DB_PASSWORD          (staging/production فقط)
#
# وإلزامي عمليًا لا بالإقلاع (له default فارغ، لكن بدونه كل طلب 400):
#     ALLOWED_HOSTS                          (production/staging)
# لا تضع قيمًا حقيقية في هذا الملف — القيم هنا placeholders فقط.
# ============================================================
